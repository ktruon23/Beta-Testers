# Copy to backend/.env and fill in what you need:  cp backend/.env.example backend/.env
# Leave optional lines commented out: an empty value overrides the default.

# ---- Claude (all agents use rule-based fallbacks when no LLM is configured)
# Anthropic API key; enables Claude in every agent.
ANTHROPIC_API_KEY=
# Claude model id.
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- Vision agent (Roboflow hold detection)
# Roboflow API key.
ROBOFLOW_API_KEY=
# Roboflow workspace name.
WORKSPACE_NAME=
# Roboflow workflow id.
WORKFLOW_ID=
# Retries for a Roboflow call.
# MAX_ATTEMPTS=5

# ---- Optional: an OpenAI-compatible server instead of Claude (NVIDIA Brev, vLLM, NIM, Ollama...)
# Force a provider: anthropic or brev (default: Claude if ANTHROPIC_API_KEY is set, else brev if LLM_BASE_URL is set).
# LLM_PROVIDER=brev
# Base URL of the server.
# LLM_BASE_URL=http://<host>:8000/v1
# Model the server is serving (default: the first one it lists).
# LLM_MODEL=
# API key, only if the server requires one.
# LLM_API_KEY=
# Seconds to wait for a model response.
# LLM_TIMEOUT=120

# ---- Optional: agent addresses (defaults match backend/run_agents.sh)
# VISION_URL=http://localhost:8001
# PLANNER_URL=http://localhost:8002
# CRITIC_URL=http://localhost:8003
# COACH_URL=http://localhost:8004

# ---- Optional: Coach feedback database (default: backend/coach-agent/coach.db)
# COACH_DB=
